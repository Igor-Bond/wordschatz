rules_version = '2';

// Правила доступа к Firestore проекта wortschatz-f1ca2.
//
// Идентификатор проекта и ключ веб-приложения не секретны: Google по замыслу
// встраивает их в клиентский код, и любой посетитель сайта их видит. Данные
// защищают именно эти правила — и ничто больше.
//
// Всё, что не разрешено явно, Firestore запрещает по умолчанию, поэтому
// отдельного запрещающего блока в конце не нужно.
//
// Загружать: консоль Firebase → Firestore Database → Rules → вставить →
// Publish. Файл в репозитории — эталон для сверки с развёрнутым.

service cloud.firestore {
  match /databases/{database}/documents {

    // Каждый пользователь видит и меняет только свои данные.
    // Без этого правила чужой человек, знающий ваш конфиг,
    // мог бы прочитать весь словарь.
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // Словарь, циклы, планы и статистика лежат подколлекциями
      match /{document=**} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }
  }
}
