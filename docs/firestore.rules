rules_version = '2';

// Правила доступа к Firestore проекта wortschatz-f1ca2.
//
// Идентификатор проекта и ключ веб-приложения не секретны: Google по замыслу
// встраивает их в клиентский код, и любой посетитель сайта их видит. Данные
// защищают именно эти правила — и ничто больше.
//
// Смысл один: пользователь работает только со своей веткой users/{uid} и
// всем, что под ней. Чужую ветку не прочитать и не переписать даже зная
// её идентификатор.
//
// Загружать сюда: консоль Firebase → Firestore Database → Rules → вставить →
// Publish. Файл в репозитории — эталон для сверки.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Слова, циклы, планы и статистика лежат подколлекциями
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Всё остальное закрыто: новых коллекций в приложении нет,
    // и появиться они должны осознанно, а не по умолчанию
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
